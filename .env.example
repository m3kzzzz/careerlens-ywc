# Server-side only. Never prefix with NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Flash model used for brochure extraction (verified in Phase 2).
GEMINI_MODEL=gemini-3.6-flash

# Optional: tried once when the main model is overloaded or out of quota ("none" disables).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
